{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash

brew bundle --file=/dev/stdin <<EOF
{{ range .packages.linux.brews -}}
brew {{ . | quote }}
{{ end -}}
EOF

if ! grep -qxF "/home/linuxbrew/.linuxbrew/bin/zsh" /etc/shells; then
    echo "/home/linuxbrew/.linuxbrew/bin/zsh" | sudo tee -a /etc/shells >/dev/null
fi
if [[ "$SHELL" != "/home/linuxbrew/.linuxbrew/bin/zsh" ]]; then
    chsh -s /home/linuxbrew/.linuxbrew/bin/zsh
fi
{{ end -}}
